# Variáveis do shim MCP do PostGrowth.
#
# Este arquivo tem apenas os NOMES das variáveis. Nenhum valor real entra aqui —
# nem em nenhum outro arquivo deste repositório, que é público.
#
# Na prática você não precisa criar um `.env`: o token vai no bloco `env` da
# configuração do seu cliente MCP (ver README.md).

# OBRIGATÓRIO. Token privado das rotas /api/mcp do PostGrowth.
# Sem ele o shim se recusa a iniciar. Peça a quem administra o PostGrowth e
# guarde como senha: ele dá acesso de escrita a posts.
POSTGROWTH_MCP_TOKEN=

# OPCIONAL. Padrão: https://postgrowth.vercel.app/api/mcp
POSTGROWTH_MCP_BASE_URL=

# OPCIONAL. Só para desenvolvimento contra um PostGrowth local.
# Sem "true" explícito, host local e de rede interna são bloqueados.
POSTGROWTH_MCP_ALLOW_LOCAL=

# OPCIONAL. Tempo limite por chamada, em milissegundos. Padrão: 30000.
POSTGROWTH_MCP_TIMEOUT_MS=
